# Optional: the desktop Configurar API dialog works without a .env.
# Copy this file to .env only if you prefer environment configuration.
# Explicit .env values override settings remembered by the desktop dialog.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# NVIDIA NIM (build.nvidia.com): usa https://integrate.api.nvidia.com/v1 e descobre os
# modelos do catálogo sem gastar tokens; o campo Modelo fica preenchido com um padrão.
# LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_API_KEY=

# Relative save names (hello.txt) resolve inside this allowlisted root.
# OUTPUT_DIRECTORY=C:/Users/YourUser/Documents/WindowsAgent
# Latency plan P2 (Host forte + App rápido): o HostAgent raciocina no cérebro
# principal e o AppAgent executa neste. Vazio = mesmo cérebro nos dois papéis.
# Ex.: LLM_APP_PROVIDER=nvidia + LLM_APP_MODEL=nvidia/nemotron-3-super-120b-a12b.
# LLM_APP_PROVIDER=
# LLM_APP_MODEL=
MAX_STEPS=20
TASK_TIMEOUT_SECONDS=300
VERIFY_RESULTS=true
# FASE 8 latency: resolve provable desktop commands without a model, and boot the UFO
# worker while the window is still opening. Set either to false to use the agent path.
FAST_PATH=true
PREWARM_DESKTOP=true
# Universal App Launcher (F-AL1–F-AL7): the machine's own application index is the
# primary source of identification, so "Abre o programa X." works for a program nobody
# listed in advance. APP_INDEX=false falls back to the curated table only; APP_SEARCH=false
# disables the one bounded search a name the index does not carry gets on the request path;
# APP_FOLDERS adds extra folders to scan (separated by the platform's path separator).
APP_INDEX=true
APP_SEARCH=true
APP_FOLDERS=
COLLECT_METRICS=true
LOG_LEVEL=INFO
# Instructions and the desktop content in task evidence (window titles, paths, typed or
# expected text, folder listings) may contain personal data. logs/tasks.jsonl keeps only
# their shape and numbers unless you opt in here, locally.
LOG_INSTRUCTIONS=false
# UFO_PATH=C:/path/to/pinned/UFO
