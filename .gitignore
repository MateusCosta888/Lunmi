# Publish only the maintained product and its public development surface.
/*
!/.gitignore
!/.gitattributes
!/.gitleaks.toml
!/.env.example
!/README.md
!/CONTRIBUTING.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/pyproject.toml
!/requirements.txt
!/requirements-dev.txt
!/requirements.lock
!/ufo.lock.json
!/install_ufo.py
!/run.bat
!/run-tk.bat
!/benchmark.bat
!/benchmark_report.py
!/app/
!/desktop/
!/tests/
!/benchmarks/
!/docs/
!/.github/

# Desktop source, pinned dependencies and required notices only.
/desktop/*
!/desktop/src/
!/desktop/electron/
!/desktop/tests/
!/desktop/licenses/
# Scripts de empacotamento/verificação: sem eles a entrega não é reproduzível.
!/desktop/scripts/
# One-off local diagnostic, not a maintained product regression.
/desktop/tests/scratch-gate-probe.test.tsx
# Hook NSIS de remoção: o build no clone precisa dele; o resto de build/ fica fora.
!/desktop/build/
/desktop/build/*
!/desktop/build/installer.nsh
# Rastreabilidade do runtime empacotado (origem/hashes e lock transitivo). O runtime binário
# e o payload montado continuam fora do controle de versão.
!/desktop/resources/
/desktop/resources/*
!/desktop/resources/RUNTIME-SOURCE.json
!/desktop/resources/requirements-runtime.lock
!/desktop/resources/VOICE-SOURCE.json
!/desktop/resources/requirements-voice.lock
!/desktop/THIRD-PARTY-MOTION.md
!/desktop/package.json
!/desktop/package-lock.json
!/desktop/tsconfig.json
!/desktop/tsconfig.electron.json
!/desktop/vite.config.ts
!/desktop/index.html

# Public docs; internal plans, reports, research and evidence remain local.
/docs/*
!/docs/README.md
!/docs/GETTING_STARTED.md
!/docs/ARCHITECTURE.md
!/docs/MEMORY.md
!/docs/UPDATES.md
!/docs/assets/
/docs/assets/*
!/docs/assets/lunmi-mark.svg
!/docs/assets/lunmi-logo.svg
!/docs/assets/lunmi-dark.png
!/docs/assets/lunmi-light.png
!/docs/assets/lunmi-brain.png
!/docs/assets/lunmi-onboarding.png

# Product regression tests; historical live-acceptance harnesses stay local.
/tests/*
!/tests/test_*.py
!/tests/conftest.py
!/tests/transport_child.py
!/tests/desktop_fixture.py
!/tests/prompt_contract_check.py
# Superfície JS pública do Spotify: o teste e os dois fixtures exigidos pelo build.
!/tests/spotify_js/
/tests/spotify_js/*
!/tests/spotify_js/client.test.mjs
!/tests/spotify_js/fake-spicetify.js
/tests/test_f2_acceptance_cleanup.py
/tests/test_f2_acceptance_consent.py
/tests/test_uia_v2_oracle.py

# Agent workspaces and machine/user state must never be published.
**/node_modules/
**/.venv/
**/.local/
**/.env
**/.env.*
!/.env.example
**/vendor/
**/logs/
**/output/
**/dist/
**/dist-electron/
**/coverage/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.agents/
**/.claude/
**/.cursor/
**/.freebuff/
**/.qoder/
**/.opencode/
**/.openclaude/
**/.maestri/
**/.impeccable/
**/opencode.json
**/*.sqlite*
**/*.db
**/*.dpapi
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.log
**/*.jsonl
**/*.tmp
**/*.bak
**/Thumbs.db
**/desktop.ini
