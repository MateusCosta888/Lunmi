# Publish only the maintained product and its public development surface.
/*
!/.gitignore
!/.gitattributes
!/.gitleaks.toml
!/.env.example
!/README.md
!/CONTRIBUTING.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/pyproject.toml
!/requirements.txt
!/requirements-dev.txt
!/requirements.lock
!/ufo.lock.json
!/install_ufo.py
!/run.bat
!/run-tk.bat
!/benchmark.bat
!/benchmark_report.py
!/app/
!/desktop/
!/tests/
!/benchmarks/
!/docs/
!/.github/

# Desktop source, pinned dependencies and required notices only.
/desktop/*
!/desktop/src/
!/desktop/electron/
!/desktop/tests/
!/desktop/licenses/
!/desktop/THIRD-PARTY-MOTION.md
!/desktop/package.json
!/desktop/package-lock.json
!/desktop/tsconfig.json
!/desktop/tsconfig.electron.json
!/desktop/vite.config.ts
!/desktop/index.html

# Public docs; internal plans, reports, research and evidence remain local.
/docs/*
!/docs/GETTING_STARTED.md
!/docs/ARCHITECTURE.md
!/docs/MEMORY.md
!/docs/assets/
/docs/assets/*
!/docs/assets/lunmi-mark.svg
!/docs/assets/lunmi-dark.png
!/docs/assets/lunmi-light.png

# Product regression tests; historical live-acceptance harnesses stay local.
/tests/*
!/tests/test_*.py
!/tests/conftest.py
!/tests/transport_child.py
!/tests/desktop_fixture.py
!/tests/prompt_contract_check.py
/tests/test_f2_acceptance_cleanup.py
/tests/test_f2_acceptance_consent.py
/tests/test_uia_v2_oracle.py

# Agent workspaces and machine/user state must never be published.
**/node_modules/
**/.venv/
**/.local/
**/.env
**/.env.*
!/.env.example
**/vendor/
**/logs/
**/output/
**/dist/
**/dist-electron/
**/coverage/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.agents/
**/.claude/
**/.cursor/
**/.freebuff/
**/.qoder/
**/.opencode/
**/.openclaude/
**/.maestri/
**/.impeccable/
**/opencode.json
**/*.sqlite*
**/*.db
**/*.dpapi
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.log
**/*.jsonl
**/*.tmp
**/*.bak
**/Thumbs.db
**/desktop.ini
