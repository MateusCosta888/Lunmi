{
  "name": "lunmi-desktop",
  "productName": "Lunmi",
  "version": "0.1.0-alpha.6",
  "private": true,
  "description": "Lunmi Desktop Shell (Electron + React + TypeScript) communicating with Python backend over stdio JSONL v1",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron && node dist-electron/electron/brand-runtime.js",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:release": "node --test scripts/update-release.test.mjs",
    "bench:f0": "npm run build && node dist-electron/electron/bench_f0.js",
    "start": "node dist-electron/electron/start.js"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "liquid-glass-react": "1.1.1",
    "lucide-react": "1.57.0",
    "motion": "14.6.0",
    "ogl": "1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "22.14.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "44.10.0",
    "electron-builder": "26.15.3",
    "jsdom": "26.1.0",
    "resedit": "3.1.0",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vitest": "5.0.4"
  },
  "build": {
    "appId": "org.lunmi.desktop",
    "compression": "maximum",
    "productName": "Lunmi",
    "copyright": "Lunmi",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "MateusCosta888",
      "repo": "Lunmi",
      "releaseType": "draft"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/media-session.ps1",
      "src/assets/branding/lunmi.ico",
      "src/assets/branding/lunmi.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/app",
        "to": "app"
      },
      {
        "from": "resources/lunmi-components.json",
        "to": "lunmi-components.json"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "THIRD-PARTY-MOTION.md",
        "to": "THIRD-PARTY-MOTION.md"
      }
    ],
    "win": {
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/branding/lunmi.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "license": "resources/voice/NOTICE.txt",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lunmi",
      "uninstallDisplayName": "Lunmi",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-${version}-Setup.${ext}"
    }
  }
}
