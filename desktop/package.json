{
  "name": "lunmi-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Lunmi Desktop Shell (Electron + React + TypeScript) communicating with Python backend over stdio JSONL v1",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "bench:f0": "npm run build && node dist-electron/electron/bench_f0.js",
    "start": "electron ."
  },
  "dependencies": {
    "lucide-react": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "22.14.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "44.7.2",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vitest": "5.0.4"
  }
}
