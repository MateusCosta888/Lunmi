{
  "version": 1,
  "limits": {
    "max_line_bytes": 5242880,
    "max_import_bytes": 4194304,
    "max_chat_text_chars": 8000,
    "max_memory_text_chars": 800,
    "max_profile_chars": 8000,
    "max_id_chars": 128,
    "max_type_chars": 64,
    "max_host_pids": 64
  },
  "patterns": {
    "id": "^[A-Za-z0-9_.:-]{1,128}$",
    "type": "^[a-z][a-z0-9_.]*$"
  },
  "default_capabilities": {
    "converse": false,
    "execute": false,
    "memory": false,
    "brain": false,
    "file_read": false,
    "web_search": false,
    "browser_use": false,
    "auto": false,
    "integrations": false
  },
  "commands": [
    "session.hello",
    "integrations.get",
    "integrations.connect",
    "integrations.cancel",
    "integrations.select",
    "integrations.disconnect",
    "chat.send",
    "task.cancel",
    "task.confirm",
    "task.answer",
    "fs.read",
    "brain.list",
    "brain.get",
    "brain.set",
    "brain.verify",
    "brain.probe",
    "approval.get",
    "approval.set",
    "memory.list",
    "memory.search",
    "memory.upsert",
    "memory.delete",
    "memory.proposals",
    "memory.propose",
    "memory.accept",
    "memory.reject",
    "memory.export",
    "memory.import",
    "memory.wipe",
    "memory.options.get",
    "memory.options.set",
    "memory.profile.get",
    "memory.profile.save",
    "memory.profile.undo",
    "ui.preferences.get",
    "ui.preferences.set",
    "app.shutdown"
  ],
  "responses": [
    "command.result",
    "command.error"
  ],
  "events": [
    "integrations.changed",
    "response.started",
    "response.text.delta",
    "response.text.stable",
    "operation.started",
    "operation.finished",
    "response.completed",
    "response.error",
    "response.cancelled",
    "session.ready",
    "chat.message",
    "task.started",
    "task.progress",
    "task.finished",
    "task.need_confirm",
    "task.need_input",
    "task.cancelled",
    "task.error",
    "brain.updated",
    "memory.changed",
    "log.append"
  ],
  "examples": {
    "hello_command": {
      "v": 1,
      "id": "cmd-hello-1",
      "type": "session.hello",
      "payload": {
        "client": "electron",
        "client_version": "0.1.0",
        "host_pids": [
          1234
        ]
      }
    },
    "ready_event": {
      "v": 1,
      "id": "evt-ready-1",
      "type": "session.ready",
      "payload": {
        "v": 1,
        "session_id": "sess-0000000000000001",
        "pid": 12345,
        "capabilities": {
          "converse": false,
          "execute": false,
          "memory": false,
          "brain": false,
          "file_read": false,
          "web_search": false,
          "browser_use": false,
          "auto": false,
          "integrations": false
        },
        "limits": {
          "max_line_bytes": 5242880,
          "max_import_bytes": 4194304,
          "max_chat_text_chars": 8000,
          "max_memory_text_chars": 800,
          "max_profile_chars": 8000,
          "max_id_chars": 128,
          "max_type_chars": 64,
          "max_host_pids": 64
        }
      }
    },
    "shutdown_command": {
      "v": 1,
      "id": "cmd-shutdown-1",
      "type": "app.shutdown",
      "payload": {}
    }
  }
}
